<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>thesis.locarno</groupId>
    <artifactId>locarno-simulation</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>Locarno MATSim Simulation</name>
    <description>MATSim and eqasim simulation runner for the Locarno scenario</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Requires JDK 25. This matches current MATSim/eqasim development setup. -->
        <maven.compiler.release>25</maven.compiler.release>

        <!-- Align this with the eqasim version you use. -->
        <matsim.version>2026.0-2026w12</matsim.version>
        <eqasim.version>2.2.0</eqasim.version>

        <!-- Change this if your runner package is thesis.run instead. -->
        <main.class>thesis.RunLocarnoEqasimSwitzerland</main.class>
    </properties>

    <repositories>
        <!-- eqasim packages -->
        <repository>
            <id>eth-ivt-eqasim</id>
            <url>https://packagecloud.io/eth-ivt/eqasim/maven2</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>

        <!-- MATSim repository -->
        <repository>
            <id>matsim</id>
            <url>https://repo.matsim.org/repository/matsim</url>
        </repository>

        <!-- GeoTools is not on Maven Central -->
        <repository>
            <id>osgeo</id>
            <url>https://repo.osgeo.org/repository/release/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- MATSim core -->
        <dependency>
            <groupId>org.matsim</groupId>
            <artifactId>matsim</artifactId>
            <version>${matsim.version}</version>
        </dependency>

        <!-- eqasim Switzerland module.
             Use this if you want the Switzerland-specific eqasim functionality / DCM setup. -->
        <dependency>
            <groupId>org.eqasim</groupId>
            <artifactId>switzerland</artifactId>
            <version>${eqasim.version}</version>
        </dependency>

        <!-- Discrete mode choice contrib used by eqasim. 
             Keeping it explicit is useful if your own runner imports DMC classes directly. -->
        <dependency>
            <groupId>org.matsim.contrib</groupId>
            <artifactId>discrete_mode_choice</artifactId>
            <version>${matsim.version}</version>
        </dependency>

        <!-- Optional: only keep this if your config/runner actually uses MATSim's bicycle contrib.
             If bike is only an allowed mode in your network/plans, you may not need this. -->
        <dependency>
            <groupId>org.matsim.contrib</groupId>
            <artifactId>bicycle</artifactId>
            <version>${matsim.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compile Java source -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!-- Allows: mvn exec:java -Dexec.mainClass=... -Dexec.args="..." -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>

            <!-- Optional, but useful if you want a standalone simulation jar for the cluster -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <outputFile>${project.basedir}/${project.artifactId}.jar</outputFile>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Main-Class>${main.class}</Main-Class>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>